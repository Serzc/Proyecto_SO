flowchart TB
  subgraph P["Proceso de aplicación (nodo k)"]
    APP["Hilos de la aplicación<br/>leen y escriben punteros DSM"]
    SIG["Manejador SIGSEGV<br/>sigaction + SA_SIGINFO"]
    FT["Hilo de fallos<br/>resolveFault"]
    NET["Hilo de red<br/>poll sobre 3 listeners"]
    SVC["Hilo de servicio<br/>PAGE_REQUEST y FREE"]
    HB["Hilos heartbeat y JOIN"]
    MEM["Región DSM<br/>memfd: vista en dsm_base + alias RW"]
    DIR["Tabla de páginas y directorio MSI"]
  end
  OTROS["Otros nodos"]
  APP -->|"acceso sin permiso"| SIG
  SIG -->|"pipe {página, escritura}"| FT
  FT -->|"mprotect + memcpy"| MEM
  FT -->|"PAGE_REQUEST"| OTROS
  OTROS -->|"PAGE_DATA, INVALIDATE, QUERY"| NET
  NET -->|"encola"| SVC
  SVC -->|"grantPage"| DIR
  FT --> DIR
  NET -->|"INVALIDATE_ACK"| OTROS
  HB <-->|"puerto heartbeat"| OTROS
